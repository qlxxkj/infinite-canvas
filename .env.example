# infinite-canvas 部署环境变量示例
# 复制为 .env（或填进 docker-compose.yml 的 environment）后，docker compose 启动时生效。
# 所有变量都可选：未设置的项前端保持默认关闭。

# ---- 统计分析（可选）----
# 每家一个独立变量，填了谁就启用谁，可同时启用多家。
ANALYTICS_GA4_ID=
ANALYTICS_BAIDU_ID=
SITE_URL=

# ---- 系统默认 Agnes 渠道（可选，推荐）----
# 设置后所有访问者打开即有可用 Agnes 默认渠道（图像/视频/文本），无需各自填 key。
# 用户已自配同 baseUrl 渠道则不重复注入、不覆盖用户配置。
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5
AGNES_TEXT_MODEL=agnes-3.0-flash
AGNES_CHANNEL_NAME=Agnes 官方
